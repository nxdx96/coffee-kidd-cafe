---
/**
 * Signup — the inline "one line" mailing capture used on Home and Coming-soon:
 * an optional title, then a single boxless row (input + arrow action sharing one
 * ink bottom rule), then an optional muted note.
 *
 * Submits to `endpoint` (mailing form service) with progressive enhancement via
 * public/forms.js: native POST without JS, fetch + in-style success with JS.
 * When no endpoint is configured, the form stays inert.
 */
import Action from './Action.astro';

interface Props {
  title?: string;
  placeholder?: string;
  actionLabel?: string;
  note?: string;
  name?: string;
  /** Mailing form-service URL (from src/lib/forms.ts). */
  endpoint?: string;
  successText?: string;
}

const {
  title,
  placeholder = 'email or phone number',
  actionLabel = 'Sign up',
  note,
  name = 'contact',
  endpoint,
  successText = "You're on the list. See you at opening.",
} = Astro.props;
---

<div class="signup" data-form>
  {title && <div class="signup__title">{title}</div>}
  <form
    class="signup__row js-form"
    method="post"
    action={endpoint}
    data-endpoint={endpoint}
  >
    <input class="signup__input" type="text" name={name} placeholder={placeholder} required />
    <Action label={actionLabel} as="submit" />
  </form>
  {note && <div class="signup__note" data-note>{note}</div>}
  <p class="signup__note form-msg" data-success role="status" aria-live="polite" hidden>
    {successText}
  </p>
  <p class="signup__note form-msg form-msg--err" data-error role="alert" hidden>
    That didn’t send — try again, or email us.
  </p>
</div>

<style>
  .signup__title {
    margin-bottom: 10px;
  }
  .signup__row {
    display: flex;
    gap: 14px;
    align-items: baseline;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 8px;
  }
  .signup__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    padding: 0;
    outline: none;
  }
  .signup__input::placeholder {
    color: var(--placeholder);
  }
  .signup__note {
    font-size: var(--size-small);
    color: var(--muted);
    margin-top: 8px;
  }
  .signup :global(.action) {
    white-space: nowrap;
  }
</style>
