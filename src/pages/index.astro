---
/**
 * Home ("/") — shows the Coming-soon layout while Site settings → "Pre-launch
 * mode" is ON, otherwise the full Home. Copy and photo come from the content
 * layer (Sanity when configured, fallback copy otherwise).
 */
import PageLayout from '../components/PageLayout.astro';
import Photo from '../components/Photo.astro';
import Signup from '../components/Signup.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { getSiteSettings, getHomePage } from '../lib/content';
import { forms } from '../lib/forms';

const settings = await getSiteSettings();
const home = await getHomePage();
---

{settings.preLaunch ? <ComingSoon /> : (
<PageLayout title="Coffee Kidd Cafe — Home" current="home">
  <p slot="info">{settings.tagline}</p>

  <p slot="info">
    {settings.addressLines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
    {settings.addressNote && (<><br /><span class="muted">{settings.addressNote}</span></>)}
  </p>

  <p slot="info">
    Hours<br />
    {
      settings.hoursLines?.length
        ? settings.hoursLines.map((line, i) => (<>{i > 0 && <br />}{line}</>))
        : <span class="muted">{settings.hoursNote}</span>
    }
  </p>

  {
    settings.nowOnWalls && (
      <p slot="info" class="muted">
        Now on the walls: <span class="ink">{settings.nowOnWalls}</span>
      </p>
    )
  }

  <div class="media">
    <Photo {...home.photo} />
  </div>

  <div class="prose">
    {home.body.map((para) => <p>{para}</p>)}
  </div>

  <div class="prose">
    <Signup
      title={home.signupTitle}
      actionLabel="Sign up"
      note={home.signupNote}
      endpoint={forms.mailing}
    />
  </div>
</PageLayout>
)}

<style>
  .ink {
    color: var(--ink);
  }
</style>
