---
/**
 * Home (placeholder).
 *
 * Phase 0 stub only — proves the layout, fonts, tokens, and cat cursor load.
 * The real Home / Coming-soon page is built in Phase 3 from ui-mockups/index.html.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Coffee Kidd Cafe — Home">
  <main style="max-width:1200px;margin:0 auto;padding:36px 40px">
    <div style="font-family:var(--font-wordmark);font-size:var(--size-wordmark);line-height:1;margin-bottom:34px">
      Coffee Kidd Cafe
    </div>
    <p>A space for coffee, tea, matcha and company.</p>
    <p style="color:var(--muted)">
      Foundation ready (Phase 0). Pages are built in the phases ahead — see
      <a href="https://github.com/">plan.md</a>.
    </p>
  </main>
</BaseLayout>
