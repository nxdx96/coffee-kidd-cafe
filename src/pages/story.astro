---
/**
 * Story (/story) — the founders' story, two portraits, and "What we're into".
 * Built from ui-mockups/story.html.
 */
import PageLayout from '../components/PageLayout.astro';
import Photo from '../components/Photo.astro';
import { getStoryPage } from '../lib/content';

const story = await getStoryPage();
---

<PageLayout
  title="Coffee Kidd Cafe — Story"
  description="The story behind Coffee Kidd Cafe — best friends Natalia Amaya and Zach Kidd, twenty years of hospitality, one McGinley Square coffee shop."
  current="story"
>
  <p slot="info">Story</p>
  <p slot="info" class="muted">
    {story.identity.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
  </p>
  <p slot="info" class="muted">{story.words}</p>

  <div class="prose">
    {story.body.map((para) => <p>{para}</p>)}
  </div>

  <div class="media portraits">
    {story.portraits.map((p) => <Photo {...p} />)}
  </div>

  <div class="into">
    <p class="into__title">{story.intoTitle}</p>
    <p class="muted">{story.intoText}</p>
  </div>
</PageLayout>

<style>
  .portraits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .into {
    max-width: var(--prose-max);
  }
  .into__title {
    margin-bottom: 6px;
  }
  @media (max-width: 760px) {
    .portraits {
      gap: 12px;
    }
  }
</style>
