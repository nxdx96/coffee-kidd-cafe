---
/**
 * Contact (/contact) — intro copy + a contact form. Built from
 * ui-mockups/contact.html. The form is inert until Phase 4 wires the email service.
 */
import PageLayout from '../components/PageLayout.astro';
import Field from '../components/Field.astro';
import ChoiceGroup from '../components/ChoiceGroup.astro';
import Action from '../components/Action.astro';
import { getSiteSettings, getContactPage } from '../lib/content';
import { forms } from '../lib/forms';

const settings = await getSiteSettings();
const contact = await getContactPage();
---

<PageLayout title="Coffee Kidd Cafe — Contact" current="contact" trailing="contact">
  <p slot="info">Contact</p>
  <p slot="info">
    <a class="ul" href={`mailto:${settings.email}`}>{settings.email}</a>
  </p>
  <p slot="info">
    {settings.addressLines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
    {settings.addressNote && (<><br /><span class="muted">{settings.addressNote}</span></>)}
  </p>
  <p slot="info">
    <a href={settings.instagram}>Instagram</a><br />
    <a href={settings.tiktok}>TikTok</a>
  </p>

  <div class="prose">
    <p>{contact.intro[0]}</p>
    {contact.intro.slice(1).map((para) => <p class="muted">{para}</p>)}
  </div>

  <div class="form-wrap" data-form>
    <form class="form js-form" method="post" action={forms.contact} data-endpoint={forms.contact}>
      <input type="hidden" name="_subject" value="Coffee Kidd — contact form" />
      <Field label="Name" name="name" placeholder="your name" required />
      <Field label="Email or phone" name="contact" placeholder="how do we reach you" required />
      <ChoiceGroup
        label="About"
        name="topic"
        options={contact.topics}
        defaultSelected={contact.topics[0]}
      />
      <Field label="Message" name="message" placeholder="tell us what's up" multiline required />
      <Action label="Send" as="submit" />
    </form>
    <p class="form-msg" data-success role="status" aria-live="polite" hidden>
      Thanks — we read everything and reply when we're not on bar.
    </p>
    <p class="form-msg form-msg--err" data-error role="alert" hidden>
      That didn't send. Email <a class="ul" href={`mailto:${settings.email}`}>{settings.email}</a> and
      we'll sort it out.
    </p>
  </div>
</PageLayout>

<style>
  .form {
    max-width: var(--prose-max);
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .ul {
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
  }
  .ul:hover {
    border-bottom-color: var(--muted);
  }
</style>
