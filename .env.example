# Public site → Sanity connection. Copy to `.env` and fill in once the founders'
# Sanity project exists (see SETUP.md). Until set, the site uses fallback copy.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-06-01

# Form submission endpoints (see SETUP.md). Until set, the forms stay inert.
# Any service that accepts a POST of the fields and returns 2xx works.
PUBLIC_MAILING_ENDPOINT=
PUBLIC_CONTACT_ENDPOINT=
