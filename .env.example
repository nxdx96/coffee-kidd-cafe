# Public site → Sanity connection. Copy to `.env` and fill in once the founders'
# Sanity project exists (see SETUP.md). Until set, the site uses fallback copy.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-06-01

# Form submission (see SETUP.md). Until set, the forms stay inert.
# Recommended: Web3Forms — set both endpoints to its submit URL and add your key.
#   PUBLIC_MAILING_ENDPOINT=https://api.web3forms.com/submit
#   PUBLIC_CONTACT_ENDPOINT=https://api.web3forms.com/submit
#   PUBLIC_WEB3FORMS_KEY=your-access-key
# (Any service that accepts a POST of the fields and returns 2xx also works,
#  e.g. Formspree — then set the endpoints to your form URLs and leave the key blank.)
PUBLIC_MAILING_ENDPOINT=
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_WEB3FORMS_KEY=
